.logo{
  position:relative;
  height: 300px;
  left: 500px;
  width: 300px;
}


header{
  background-color:black;
}


h1{
   color: white;
   text-align: center;
   font-family:Georgia, 'Times New Roman', Times, serif;
   font-weight: 400;
   font-style: oblique;
   text-shadow: 2px 2px;
}
.navbar ul{
    list-style-type: none;
    background-color: rgb(4, 73, 15);
    padding: 0px;
    margin: 0px;
    overflow: hidden;
}
.navbar a{
    color:yellow;
    text-decoration: none;
    padding: 15px;
    display: block;
    text-align: center;
}
.navbar a:hover{
    background-color: rgb(32, 94, 74);
}
.navbar li{
    float: left;
}


main{
  background-color:  rgb(4, 73, 15);
}

h4{
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    text-align: center;
    color: beige;
}
p{
    font-family:Georgia, 'Times New Roman', Times, serif;
    font-size:len;
    font-weight:lighter;
    font-style: italic;
    text-align: center;
}


h3{
  text-align: center;
}


div{
  margin: 0px;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Times New Roman', Times, serif;
}
.card-container{
  display: flex;
  justify-content: center;
  margin-top: 100px;
}
.card{ 
  width: 325px;
  background-color:whitesmoke;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0px 2px 4px rgba(0,0,0,0.2);
  margin: 20px;
}


.about{
  float: center;
  width: 300px;
  right: 300px;
}
.cen{
  position: relative;
  width: 700px;
  left: 300px;
  top: -300px;
  padding: 100px;
}
.about2{
  float: center;
