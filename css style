}


table{
  background-color: blue;
  align-self: center;
}
tr{
  text-align: center;
}


*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.container{
  max-width: 1170px;
  margin: auto;
}
.row{
  display: flex;
  flex-wrap: wrap;
}
ul{
  list-style: none;
}
.footer{
  background-color: yellow;
  padding:70px 0;
}
.footer-col{
  width: 200px;
  padding: 0 15px;
}
.footer-col h4{
  font-size: 18px;
  color: black;
  margin-bottom: 30px;
}
.footer-col ul li{
  margin-bottom: 10px;
}
.footer-col ul li a:hover{
  color: rgb(219, 19, 19);
  padding-left: 10px;
}

